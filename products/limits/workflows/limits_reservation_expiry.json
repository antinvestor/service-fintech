{
  "version": "1.2",
  "name": "limits_reservation_expiry",
  "description": "Every minute: LimitsJobRun(RESERVATION_EXPIRY) expires active reservations past their deadline, returning their hold.",
  "input": {
    "schedule_name": "limits_reservation_expiry"
  },
  "config": {
    "process_commands": [
      "limits.v1.LimitsAdminService/LimitsJobRun"
    ],
    "terminal_states": [
      "stalled"
    ],
    "owner": "fintech"
  },
  "schedules": [
    {
      "name": "limits_reservation_expiry",
      "cron_expr": "* * * * *",
      "timezone": "UTC",
      "input_payload": {}
    }
  ],
  "steps": [
    {
      "id": "run",
      "type": "call",
      "name": "RUN \u2014 one pass of the reaper",
      "call": {
        "action": "connect.call",
        "input": {
          "service": "limits.v1.LimitsAdminService",
          "rpc": "LimitsJobRun",
          "request": {
            "job": "LIMITS_JOB_RESERVATION_EXPIRY"
          },
          "endpoint": "${SERVICE_ENDPOINT}"
        },
        "output_var": "batch"
      },
      "retry": {
        "max_attempts": 3,
        "initial_interval": "10s",
        "backoff_coefficient": 2.0,
        "max_interval": "2m"
      },
      "on_success": [
        {
          "condition": "true",
          "target": "end"
        }
      ],
      "on_failure": "stalled"
    },
    {
      "id": "stalled",
      "type": "call",
      "name": "STALLED (terminal) \u2014 the job failed after retries; the next schedule tries again",
      "call": {
        "action": "log.entry",
        "input": {
          "level": "error",
          "message": "limits_reservation_expiry stalled after retries",
          "data": {
            "instance_id": "{{ metadata.instance_id }}",
            "execution_id": "{{ metadata.execution_id }}"
          }
        }
      },
      "on_success": "end"
    },
    {
      "id": "end",
      "type": "call",
      "name": "END \u2014 instance terminal",
      "call": {
        "action": "log.entry",
        "input": {
          "level": "info",
          "message": "limits_reservation_expiry done",
          "data": {
            "instance_id": "{{ metadata.instance_id }}"
          }
        }
      }
    }
  ]
}
