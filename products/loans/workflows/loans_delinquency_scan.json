{
  "version": "1.2",
  "name": "loans_delinquency_scan",
  "description": "Every 10 minutes: LoanJobRun(DELINQUENCY_SCAN) assesses the loans due for their daily look (days past due, late penalties, arrears, default, cure). Each loan is claimed once a day, so the run drains whatever is due in batches until the service reports no more.",
  "input": {
    "schedule_name": "loans_delinquency_scan"
  },
  "config": {
    "process_commands": [
      "loans.v1.LoanManagementService/LoanJobRun"
    ],
    "terminal_states": [
      "stalled"
    ],
    "owner": "fintech"
  },
  "schedules": [
    {
      "name": "loans_delinquency_scan",
      "cron_expr": "*/10 * * * *",
      "timezone": "UTC",
      "input_payload": {}
    }
  ],
  "steps": [
    {
      "id": "run",
      "type": "call",
      "name": "RUN \u2014 one bounded batch; repeats while the service reports more",
      "call": {
        "action": "connect.call",
        "input": {
          "service": "loans.v1.LoanManagementService",
          "rpc": "LoanJobRun",
          "request": {
            "job": "LOAN_JOB_DELINQUENCY_SCAN",
            "batchSize": 500
          }
        },
        "output_var": "batch"
      },
      "retry": {
        "max_attempts": 3,
        "initial_interval": "10s",
        "backoff_coefficient": 2.0,
        "max_interval": "2m"
      },
      "on_success": [
        {
          "condition": "has(vars.batch.more) && vars.batch.more == true",
          "target": "run"
        },
        {
          "condition": "true",
          "target": "end"
        }
      ],
      "on_failure": "stalled"
    },
    {
      "id": "stalled",
      "type": "call",
      "name": "STALLED (terminal) \u2014 the job failed after retries; the next schedule tries again",
      "call": {
        "action": "log.entry",
        "input": {
          "level": "error",
          "message": "loans_delinquency_scan stalled after retries",
          "data": {
            "instance_id": "{{ metadata.instance_id }}",
            "execution_id": "{{ metadata.execution_id }}"
          }
        }
      },
      "on_success": "end"
    },
    {
      "id": "end",
      "type": "call",
      "name": "END \u2014 instance terminal",
      "call": {
        "action": "log.entry",
        "input": {
          "level": "info",
          "message": "loans_delinquency_scan done",
          "data": {
            "instance_id": "{{ metadata.instance_id }}"
          }
        }
      }
    }
  ]
}
