{
  "version": "1.2",
  "name": "loans_request_expiry",
  "description": "Every 15 minutes: LoanJobRun(REQUEST_EXPIRY) expires submitted or approved loan requests whose offer deadline passed and tells the borrower.",
  "input": {
    "schedule_name": "loans_request_expiry"
  },
  "config": {
    "process_commands": [
      "loans.v1.LoanManagementService/LoanJobRun"
    ],
    "terminal_states": [
      "stalled"
    ],
    "owner": "fintech"
  },
  "schedules": [
    {
      "name": "loans_request_expiry",
      "cron_expr": "*/15 * * * *",
      "timezone": "UTC",
      "input_payload": {}
    }
  ],
  "steps": [
    {
      "id": "run",
      "type": "call",
      "name": "RUN \u2014 one bounded batch; repeats while the service reports more",
      "call": {
        "action": "connect.call",
        "input": {
          "service": "loans.v1.LoanManagementService",
          "rpc": "LoanJobRun",
          "request": {
            "job": "LOAN_JOB_REQUEST_EXPIRY",
            "batchSize": 500
          },
          "endpoint": "${SERVICE_ENDPOINT}"
        },
        "output_var": "batch"
      },
      "retry": {
        "max_attempts": 3,
        "initial_interval": "10s",
        "backoff_coefficient": 2.0,
        "max_interval": "2m"
      },
      "on_success": [
        {
          "condition": "has(vars.batch.more) && vars.batch.more == true",
          "target": "run"
        },
        {
          "condition": "true",
          "target": "end"
        }
      ],
      "on_failure": "stalled"
    },
    {
      "id": "stalled",
      "type": "call",
      "name": "STALLED (terminal) \u2014 the job failed after retries; the next schedule tries again",
      "call": {
        "action": "log.entry",
        "input": {
          "level": "error",
          "message": "loans_request_expiry stalled after retries",
          "data": {
            "instance_id": "{{ metadata.instance_id }}",
            "execution_id": "{{ metadata.execution_id }}"
          }
        }
      },
      "on_success": "end"
    },
    {
      "id": "end",
      "type": "call",
      "name": "END \u2014 instance terminal",
      "call": {
        "action": "log.entry",
        "input": {
          "level": "info",
          "message": "loans_request_expiry done",
          "data": {
            "instance_id": "{{ metadata.instance_id }}"
          }
        }
      }
    }
  ]
}
