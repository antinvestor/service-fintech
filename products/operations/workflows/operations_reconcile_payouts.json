{
  "version": "1.2",
  "name": "operations_reconcile_payouts",
  "description": "Every 10 minutes: OperationsJobRun(RECONCILE_PAYOUTS) asks the payment service how payouts it accepted ended, reverses those the rail failed afterwards, tells their originators, and reports payouts undecided after a day.",
  "input": {
    "schedule_name": "operations_reconcile_payouts"
  },
  "config": {
    "process_commands": [
      "operations.v1.OperationsService/OperationsJobRun"
    ],
    "terminal_states": [
      "stalled"
    ],
    "owner": "fintech"
  },
  "schedules": [
    {
      "name": "operations_reconcile_payouts",
      "cron_expr": "*/10 * * * *",
      "timezone": "UTC",
      "input_payload": {}
    }
  ],
  "steps": [
    {
      "id": "run",
      "type": "call",
      "name": "RUN \u2014 one bounded batch; repeats while the service reports more",
      "call": {
        "action": "connect.call",
        "input": {
          "service": "operations.v1.OperationsService",
          "rpc": "OperationsJobRun",
          "request": {
            "job": "OPERATIONS_JOB_RECONCILE_PAYOUTS",
            "batchSize": 200
          },
          "endpoint": "${SERVICE_ENDPOINT}"
        },
        "output_var": "batch"
      },
      "retry": {
        "max_attempts": 3,
        "initial_interval": "10s",
        "backoff_coefficient": 2.0,
        "max_interval": "2m"
      },
      "on_success": [
        {
          "condition": "has(vars.batch.more) && vars.batch.more == true",
          "target": "run"
        },
        {
          "condition": "true",
          "target": "end"
        }
      ],
      "on_failure": "stalled"
    },
    {
      "id": "stalled",
      "type": "call",
      "name": "STALLED (terminal) \u2014 the job failed after retries; the next schedule tries again",
      "call": {
        "action": "log.entry",
        "input": {
          "level": "error",
          "message": "operations_reconcile_payouts stalled after retries",
          "data": {
            "instance_id": "{{ metadata.instance_id }}",
            "execution_id": "{{ metadata.execution_id }}"
          }
        }
      },
      "on_success": "end"
    },
    {
      "id": "end",
      "type": "call",
      "name": "END \u2014 instance terminal",
      "call": {
        "action": "log.entry",
        "input": {
          "level": "info",
          "message": "operations_reconcile_payouts done",
          "data": {
            "instance_id": "{{ metadata.instance_id }}"
          }
        }
      }
    }
  ]
}
