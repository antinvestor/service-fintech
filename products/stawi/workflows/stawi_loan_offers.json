{
  "version": "1.2",
  "name": "stawi_loan_offers",
  "description": "Every 10 minutes: StawiJobRun(LOAN_OFFERS) finishes accepted offers whose loan is not paid yet, closes offers nobody answered in time, and retries cancelling the loans of offers that could not be paid; idempotent per offer.",
  "input": {
    "schedule_name": "stawi_loan_offers"
  },
  "config": {
    "process_commands": [
      "stawi.v1.StawiService/StawiJobRun"
    ],
    "terminal_states": [
      "stalled"
    ],
    "owner": "fintech"
  },
  "schedules": [
    {
      "name": "stawi_loan_offers",
      "cron_expr": "*/10 * * * *",
      "timezone": "UTC",
      "input_payload": {}
    }
  ],
  "steps": [
    {
      "id": "run",
      "type": "call",
      "name": "RUN \u2014 one bounded batch; repeats while the service reports more",
      "call": {
        "action": "connect.call",
        "input": {
          "service": "stawi.v1.StawiService",
          "rpc": "StawiJobRun",
          "request": {
            "job": "STAWI_JOB_LOAN_OFFERS",
            "batchSize": 200
          },
          "endpoint": "${SERVICE_ENDPOINT}"
        },
        "output_var": "batch"
      },
      "retry": {
        "max_attempts": 3,
        "initial_interval": "10s",
        "backoff_coefficient": 2.0,
        "max_interval": "2m"
      },
      "on_success": [
        {
          "condition": "has(vars.batch.more) && vars.batch.more == true",
          "target": "run"
        },
        {
          "condition": "true",
          "target": "end"
        }
      ],
      "on_failure": "stalled"
    },
    {
      "id": "stalled",
      "type": "call",
      "name": "STALLED (terminal) \u2014 the job failed after retries; the next schedule tries again",
      "call": {
        "action": "log.entry",
        "input": {
          "level": "error",
          "message": "stawi_loan_offers stalled after retries",
          "data": {
            "instance_id": "{{ metadata.instance_id }}",
            "execution_id": "{{ metadata.execution_id }}"
          }
        }
      },
      "on_success": "end"
    },
    {
      "id": "end",
      "type": "call",
      "name": "END \u2014 instance terminal",
      "call": {
        "action": "log.entry",
        "input": {
          "level": "info",
          "message": "stawi_loan_offers done",
          "data": {
            "instance_id": "{{ metadata.instance_id }}"
          }
        }
      }
    }
  ]
}
